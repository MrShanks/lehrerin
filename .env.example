# Copy this file to .env and fill in your own Cloudflare Tunnel token.
# Get one from the Cloudflare Zero Trust dashboard: Networks > Tunnels > your tunnel > Install connector.
CLOUDFLARE_TUNNEL_TOKEN=

# Anyone signing up must enter this code. Pick your own secret value and only
# share it with the teachers you want to allow. Leave unset to allow open signup.
SIGNUP_INVITE_CODE=change-me-to-a-secret-value

# HTTP Basic Auth credentials protecting the whole app once it's exposed
# publicly. Leave both blank to disable auth (e.g. for local development).
AUTH_USERNAME=
AUTH_PASSWORD=
